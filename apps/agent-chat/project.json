{
  "name": "agent-chat",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/agent-chat/src",
  "tags": ["scope:examples", "type:app"],
  "// targets": "to see all targets run: nx show project agent-chat --web",
  "targets": {
    "typecheck": {
      "inputs": [
        "default",
        "^production",
        {
          "externalDependencies": ["typescript"]
        }
      ],
      "options": {
        "command": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit"
      }
    }
  }
}
