{
  "name": "docs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/docs",
  "tags": ["scope:examples", "type:app"],
  "implicitDependencies": [
    "example-snippets",
    "engine-chat",
    "agent-chat",
    "vanilla-agui",
    "angular-copilotkit",
    "react-copilotkit",
    "vue-copilotkit",
    "docs-assistant"
  ],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docusaurus start apps/docs --port 4400"
      },
      "dependsOn": ["api", "examples"]
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/docs"],
      "options": {
        "command": "docusaurus build apps/docs --out-dir ../../dist/apps/docs"
      },
      "dependsOn": ["api", "examples"]
    },
    "serve-static": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "docusaurus serve apps/docs --dir ../../dist/apps/docs --port 4401 --no-open"
      }
    },
    "examples": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/static/examples"],
      "options": {
        "parallel": false,
        "commands": [
          "rm -rf apps/docs/static/examples dist/docs-examples && mkdir -p apps/docs/static/examples",
          "pnpm nx run angular-copilotkit:build:production --excludeTaskDependencies --base-href=/examples/angular/ --outputPath=dist/docs-examples/angular",
          "cp -R dist/docs-examples/angular/browser apps/docs/static/examples/angular",
          "cd apps/react-copilotkit && pnpm exec vite build --base /examples/react/ --outDir ../docs/static/examples/react --emptyOutDir",
          "cd apps/vue-copilotkit && pnpm exec vite build --base /examples/vue/ --outDir ../docs/static/examples/vue --emptyOutDir",
          "cd apps/vanilla-agui && pnpm exec vite build --base /examples/vanilla/ --outDir ../docs/static/examples/vanilla --emptyOutDir",
          "cd apps/engine-chat && pnpm exec vite build --base /examples/engine/ --outDir ../docs/static/examples/engine --emptyOutDir",
          "cd apps/agent-chat && pnpm exec vite build --base /examples/agent/ --outDir ../docs/static/examples/agent --emptyOutDir",
          "cd apps/docs-assistant && pnpm exec vite build --base /examples/assistant/ --outDir ../docs/static/examples/assistant --emptyOutDir"
        ]
      },
      "dependsOn": ["api"]
    },
    "check-code": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/docs/**/*.md",
        "!{projectRoot}/docs/api/**/*",
        "{workspaceRoot}/README.md",
        "{projectRoot}/scripts/**/*",
        "{workspaceRoot}/tsconfig.base.json",
        "^production",
        { "externalDependencies": ["typescript"] }
      ],
      "options": {
        "command": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON apps/docs/scripts/check-code.ts"
      }
    },
    "api": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/typedoc.base.json",
        "{workspaceRoot}/libs/agent/browser-models/typedoc.json",
        "{workspaceRoot}/libs/agent/browser-models-agui/typedoc.json",
        "{workspaceRoot}/libs/agent/browser-models-tools/typedoc.json",
        "{workspaceRoot}/libs/frameworks/angular/typedoc.json",
        "{workspaceRoot}/libs/frameworks/react/typedoc.json",
        "{workspaceRoot}/libs/frameworks/vue/typedoc.json",
        "{workspaceRoot}/libs/agent/browser-models/src/**/*.ts",
        "{workspaceRoot}/libs/agent/browser-models-agui/src/**/*.ts",
        "{workspaceRoot}/libs/agent/browser-models-tools/src/**/*.ts",
        "{workspaceRoot}/libs/frameworks/angular/src/**/*.ts",
        "{workspaceRoot}/libs/frameworks/react/src/**/*.ts",
        "{workspaceRoot}/libs/frameworks/vue/src/**/*.ts"
      ],
      "outputs": ["{projectRoot}/docs/api"],
      "options": {
        "parallel": false,
        "commands": [
          "rm -rf apps/docs/docs/api",
          "cd libs/agent/browser-models && typedoc --options typedoc.json",
          "cd libs/agent/browser-models-agui && typedoc --options typedoc.json",
          "cd libs/agent/browser-models-tools && typedoc --options typedoc.json",
          "cd libs/frameworks/angular && typedoc --options typedoc.json",
          "cd libs/frameworks/react && typedoc --options typedoc.json",
          "cd libs/frameworks/vue && typedoc --options typedoc.json"
        ]
      }
    }
  }
}
