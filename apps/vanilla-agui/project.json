{
  "name": "vanilla-agui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/vanilla-agui/src",
  "tags": ["scope:examples", "type:app"],
  "// targets": "to see all targets run: nx show project vanilla-agui --web",
  "targets": {
    "typecheck": {
      "inputs": [
        "default",
        "^production",
        {
          "externalDependencies": ["typescript"]
        }
      ],
      "options": {
        "command": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit"
      }
    }
  }
}
