    },
    "./copilotkit": {
      "types": "./copilotkit.d.ts",
      "import": "./copilotkit.js",
      "default": "./copilotkit.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Soverius-AI/browser-models.git",
    "directory": "libs/agent/browser-models-tools"
  },
  "publishConfig": {
    "access": "public"
