{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "docusaurus.config.ts",
    "sidebars.ts",
    "plugins/**/*.ts",
    "src/source-files.ts",
    "scripts/**/*.ts"
  ]
}
