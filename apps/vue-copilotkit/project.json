{
  "name": "vue-copilotkit",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/vue-copilotkit/src",
  "tags": ["scope:examples", "type:app"],
  "// targets": "to see all targets run: nx show project vue-copilotkit --web",
  "targets": {
    "typecheck": {
      "inputs": [
        "default",
        "^production",
        {
          "externalDependencies": ["vue-tsc", "typescript"]
        }
      ],
      "options": {
        "command": "vue-tsc -p tsconfig.app.json --noEmit && vue-tsc -p tsconfig.spec.json --noEmit"
      }
    }
  }
}
