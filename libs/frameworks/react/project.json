{
  "name": "react",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/frameworks/react/src",
  "projectType": "library",
  "tags": ["scope:frameworks", "type:framework"],
  "targets": {
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "publint": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "cache": true,
      "inputs": ["production", "^production"],
      "options": {
        "command": "publint dist/libs/frameworks/react --strict"
      }
    },
    "typecheck": {
      "inputs": [
        "default",
        "^production",
        {
          "externalDependencies": ["typescript"]
        }
      ],
      "options": {
        "command": "tsc -p tsconfig.lib.json --noEmit && tsc -p tsconfig.spec.json --noEmit"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "outputs": ["{workspaceRoot}/dist/libs/frameworks/react"],
      "inputs": [
        "production",
        "^production",
        {
          "externalDependencies": ["esbuild", "typescript"]
        },
        "{workspaceRoot}/tools/library-build.ts"
      ],
      "options": {
        "command": "node tools/library-build.ts libs/frameworks/react dist/libs/frameworks/react"
      }
    }
  }
}
