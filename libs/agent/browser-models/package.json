{
  "name": "@soverius-ai/browser-models",
  "version": "0.2.2",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "dependencies": {
    "@types/dom-chromium-ai": "^0.0.18"
  },
  "sideEffects": [
    "./web-llm-default.worker.js"
  ],
  "license": "MIT",
  "homepage": "https://browser-models.soverius.ai",
  "description": "Run models in the browser: one engine interface for the Prompt API, WebLLM and transformers.js.",
  "peerDependencies": {
    "@mlc-ai/web-llm": "^0.2.88",
    "@huggingface/transformers": "^4.3.2"
  },
  "peerDependenciesMeta": {
    "@mlc-ai/web-llm": {
      "optional": true
    },
    "@huggingface/transformers": {
      "optional": true
    }
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./prompt-api": {
      "types": "./prompt-api.d.ts",
      "import": "./prompt-api.js",
      "default": "./prompt-api.js"
    },
    "./web-llm": {
      "types": "./web-llm.d.ts",
      "import": "./web-llm.js",
      "default": "./web-llm.js"
    },
    "./web-llm/worker": {
      "types": "./web-llm-worker.d.ts",
      "import": "./web-llm-worker.js",
      "default": "./web-llm-worker.js"
    },
    "./transformers": {
      "types": "./transformers.d.ts",
      "import": "./transformers.js",
      "default": "./transformers.js"
    },
    "./engines": {
      "types": "./engines.d.ts",
      "import": "./engines.js",
      "default": "./engines.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Soverius-AI/browser-models.git",
    "directory": "libs/agent/browser-models"
  },
  "publishConfig": {
    "access": "public"
  }
}
