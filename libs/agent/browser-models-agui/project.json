{
  "name": "browser-models-agui",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/agent/browser-models-agui/src",
  "projectType": "library",
  "tags": ["scope:agent", "type:agent"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/libs/agent/browser-models-agui"],
      "inputs": [
        "production",
        "^production",
        {
          "externalDependencies": ["esbuild", "typescript"]
        },
        "{workspaceRoot}/tools/library-build.ts"
      ],
      "options": {
        "command": "node tools/library-build.ts libs/agent/browser-models-agui dist/libs/agent/browser-models-agui"
      },
      "dependsOn": ["^build"]
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "publint": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "cache": true,
      "inputs": ["production", "^production"],
      "options": {
        "command": "publint dist/libs/agent/browser-models-agui --strict"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^production",
        {
          "externalDependencies": ["typescript"]
        }
      ],
      "options": {
        "cwd": "{projectRoot}",
        "commands": [
          "tsc -p tsconfig.lib.json --noEmit",
          "tsc -p tsconfig.spec.json --noEmit"
        ],
        "parallel": false
      }
    }
  }
}
