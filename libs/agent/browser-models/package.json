{
  "name": "@soverius-ai/browser-models",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "dependencies": {
    "tslib": "^2.3.0",
    "@types/dom-chromium-ai": "^0.0.18"
  },
  "sideEffects": false,
  "license": "MIT",
  "homepage": "https://browser-models.soverius.ai",
  "description": "Run models in the browser: one engine interface for the Prompt API, WebLLM and transformers.js.",
  "peerDependencies": {
    "@mlc-ai/web-llm": "^0.2.88",
    "@huggingface/transformers": "^4.3.2"
  },
  "peerDependenciesMeta": {
    "@mlc-ai/web-llm": {
      "optional": true
    },
    "@huggingface/transformers": {
      "optional": true
    }
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./prompt-api": {
      "types": "./src/prompt-api.d.ts",
      "import": "./src/prompt-api.js",
      "default": "./src/prompt-api.js"
    },
    "./web-llm": {
      "types": "./src/web-llm.d.ts",
      "import": "./src/web-llm.js",
      "default": "./src/web-llm.js"
    },
    "./web-llm/worker": {
      "types": "./src/web-llm-worker.d.ts",
      "import": "./src/web-llm-worker.js",
      "default": "./src/web-llm-worker.js"
    },
    "./transformers": {
      "types": "./src/transformers.d.ts",
      "import": "./src/transformers.js",
      "default": "./src/transformers.js"
    },
    "./engines": {
      "types": "./src/engines.d.ts",
      "import": "./src/engines.js",
      "default": "./src/engines.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Soverius-AI/browser-models.git",
    "directory": "libs/agent/browser-models"
  },
  "publishConfig": {
    "access": "public"
  }
}
